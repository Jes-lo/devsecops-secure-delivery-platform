{
  "name": "devsecops-secure-delivery-platform",
  "version": "0.1.0",
  "description": "Greenfield DevSecOps secure software delivery portfolio project",
  "scripts": {
    "test": "node --test",
    "start": "node src/server.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.js --test-coverage-exclude=src/server.js --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80",
    "audit": "npm audit --audit-level=high",
    "smoke": "bash scripts/smoke-test.sh",
    "verify": "npm run test:coverage && npm run audit && npm run smoke"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  },
  "packageManager": "npm@11.19.0"
}
